# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct access to sensitive files and folders
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.env.* - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|vendor|tests)(/|$) - [F,L]
    RewriteRule ^storage/(framework|logs)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|artisan)$ - [F,L]

    # 2. If already inside public directory, do not rewrite further
    RewriteCond %{REQUEST_URI} ^.*/public/ [NC]
    RewriteRule ^ - [L]

    # 3. Allow direct access to update.php and setup.php in root
    RewriteRule ^(update\.php|setup\.php) - [L]

    # 4. Route root URL and all other requests to public folder
    RewriteRule ^$ public/ [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Enable Long-lived Browser Caching & CORS for Static Assets
<IfModule mod_headers.c>
    Header set Connection keep-alive
    <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|eot|png|jpg|jpeg|gif|svg|webp|ico|json)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
