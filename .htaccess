<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # 1. Block direct access to sensitive files and folders
    RewriteRule ^\.git - [F,L]
    RewriteRule ^\.env.* - [F,L]
    RewriteRule ^(app|bootstrap|config|database|resources|routes|vendor|tests)(/|$) - [F,L]
    RewriteRule ^storage/(framework|logs)(/|$) - [F,L]
    RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json|vite\.config\.js|artisan)$ - [F,L]

    # 2. Pass Authorization Header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 3. Direct route to public static assets
    RewriteRule ^build/(.*)$ public/build/$1 [L]
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]
    RewriteRule ^icons/(.*)$ public/icons/$1 [L]
    RewriteRule ^(favicon\.ico|robots\.txt|sw\.js|manifest\.json|manifest\.webmanifest)$ public/$1 [L]

    # 4. Route all application requests directly to root index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Enable Long-lived Browser Caching & CORS for Static Assets
<IfModule mod_headers.c>
    Header set Connection keep-alive
    <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|eot|png|jpg|jpeg|gif|svg|webp|ico|json)$">
        Header set Access-Control-Allow-Origin "*"
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
